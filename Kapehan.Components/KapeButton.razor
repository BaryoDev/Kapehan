@*
  KapeButton.razor: Kapehan "Button" (Actions).

  GENERATED from kapehan-components.js by scripts/generators/blazor.mjs. Do not edit by
  hand; edit design/Kapehan.dc.html and run `npm run build`. npm test fails if this drifts.

  Styling comes entirely from kapehan.css. Reference it once in the host app:
      <link rel="stylesheet" href="_content/Kapehan.Components/kapehan.css" />

  Props (* = required):
      label*: string
      variant: 'primary' | 'default' | 'ghost'
      icon: string | null
      disabled: boolean
      onClick: () => void

  Accessibility contract:
      roles: Native button element, no role override needed
      attrs: disabled
             aria-busy on a submitting button
             aria-label when the button is icon-only
      keys:  Enter or Space activates
             Tab moves in and out
*@

<button class="@Classes" disabled="@Disabled" @onclick="OnClick">
    @if (Icon is not null)
    {
        <KapeIcon Name="@Icon" Size="20" />
    }
    @Label
</button>

@code {
    /// <summary>Text inside the button.</summary>
    /// <remarks>Canvas default: <c>Order now</c>.</remarks>
    [Parameter] public string Label { get; set; } = "Order now";
    /// <summary>Fill treatment.</summary>
    /// <remarks>Canvas default: <c>default</c>.</remarks>
    [Parameter] public string Variant { get; set; } = "default";
    /// <summary>Kapehan icon name shown before the label.</summary>
    /// <remarks>Canvas default: <c>null</c>.</remarks>
    [Parameter] public string? Icon { get; set; }
    /// <summary>Blocks pointer and keyboard activation.</summary>
    /// <remarks>Canvas default: <c>false</c>.</remarks>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Fired on activation.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    private string Classes => Variant switch
    {
        "primary" => "kape-btn kape-btn--primary",
        "ghost" => "kape-btn kape-btn--ghost",
        _ => "kape-btn",
    };
}
