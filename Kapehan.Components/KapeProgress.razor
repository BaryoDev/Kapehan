@*
  KapeProgress.razor: Kapehan "Progress" (Feedback).

  GENERATED from kapehan-components.js by scripts/generators/blazor.mjs. Do not edit by
  hand; edit design/Kapehan.dc.html and run `npm run build`. npm test fails if this drifts.

  Styling comes entirely from kapehan.css. Reference it once in the host app:
      <link rel="stylesheet" href="_content/Kapehan.Components/kapehan.css" />

  Props (* = required):
      value*: number
      label*: string

  Accessibility contract:
      roles: role="progressbar"
      attrs: aria-valuenow, and aria-valuemin/max when they are not 0 and 100
             aria-label or aria-labelledby naming the task
      keys:  Not focusable; it reports, it does not accept input
*@

<span class="kape-progress" role="progressbar" aria-valuenow="@Value" aria-valuemin="0" aria-valuemax="100" aria-label="@Label">
    <span style="width:@(Value)%"></span>
</span>

@code {
    /// <summary>Percentage, 0 to 100.</summary>
    /// <remarks>Canvas default: <c>0</c>.</remarks>
    [Parameter] public int Value { get; set; }
    /// <summary>What is progressing.</summary>
    [Parameter] public string Label { get; set; } = "";
}
