@*
  KapeSwitch.razor: Kapehan "Switch" (Actions).

  GENERATED from kapehan-components.js by scripts/generators/blazor.mjs. Do not edit by
  hand; edit design/Kapehan.dc.html and run `npm run build`. npm test fails if this drifts.

  Styling comes entirely from kapehan.css. Reference it once in the host app:
      <link rel="stylesheet" href="_content/Kapehan.Components/kapehan.css" />

  Props (* = required):
      modelValue*: boolean
      label*: string
      disabled: boolean

  Accessibility contract:
      roles: A native checkbox inside a label; role="switch" is optional and only if you also manage aria-checked
      attrs: The label text must be adjacent, not a title attribute
      keys:  Space toggles
             Tab focuses the input, which is visually hidden but not display:none
*@

<label class="kape-switch">
    <input type="checkbox" @bind="Value" disabled="@Disabled" />
</label>
<span>@Label</span>

@code {
    /// <summary>On or off.</summary>
    /// <remarks>Canvas default: <c>false</c>.</remarks>
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    /// <summary>What the switch controls.</summary>
    [Parameter] public string Label { get; set; } = "";
    /// <summary>Blocks toggling.</summary>
    /// <remarks>Canvas default: <c>false</c>.</remarks>
    [Parameter] public bool Disabled { get; set; }
}
