@*
  KapeDialog.razor: Kapehan "Dialog" (Feedback).

  GENERATED from kapehan-components.js by scripts/generators/blazor.mjs. Do not edit by
  hand; edit design/Kapehan.dc.html and run `npm run build`. npm test fails if this drifts.

  Styling comes entirely from kapehan.css. Reference it once in the host app:
      <link rel="stylesheet" href="_content/Kapehan.Components/kapehan.css" />

  Props (* = required):
      open*: boolean
      title*: string
      body: string
      confirmLabel: string
      onConfirm*: () => void
      onClose*: () => void

  Accessibility contract:
      roles: Native dialog element gives role="dialog" and aria-modal for free
      attrs: aria-labelledby pointing at the heading
             Focus must land on the least destructive action, not the confirm
      keys:  Escape closes (native)
             Tab is trapped inside while modal (native)
*@

@inject IJSRuntime JS

<dialog @ref="_el" @oncancel="OnNativeCancel" @onclose="OnNativeClose" class="kape-dialog" aria-labelledby="kape-dialog-title">
    <h2 id="kape-dialog-title">@Title</h2>
    <p>@Body</p>
    <div class="kape-dialog__actions">
        <button class="kape-btn kape-btn--ghost" autofocus @onclick="OnClose">Keep it</button>
        <button class="kape-btn kape-btn--ink" @onclick="OnConfirm">@ConfirmLabel</button>
    </div>
</dialog>

@code {
    /// <summary>Whether the modal is shown.</summary>
    /// <remarks>Canvas default: <c>false</c>.</remarks>
    [Parameter] public bool Open { get; set; }
    /// <summary>One question or one statement.</summary>
    [Parameter] public string Title { get; set; } = "";
    /// <summary>One or two lines of consequence.</summary>
    [Parameter] public string Body { get; set; } = "";
    /// <summary>Destructive action label.</summary>
    /// <remarks>Canvas default: <c>Confirm</c>.</remarks>
    [Parameter] public string ConfirmLabel { get; set; } = "Confirm";
    /// <summary>Fired by the confirm button.</summary>
    [Parameter] public EventCallback OnConfirm { get; set; }
    /// <summary>Fired by the cancel button or by Escape.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference _el;
    private bool _interactive;
    private bool _shown;

    // Prerender has no JS runtime, so every interop call waits for the first render.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _interactive = true;
        if (!_interactive || Open == _shown) return;
        _shown = Open;
        await JS.InvokeVoidAsync(Open ? "kapehan.dialog.show" : "kapehan.dialog.close", _el);
    }

    // Escape closes the element in the DOM without telling Blazor. cancel reports that the
    // way the close button does; close resyncs _shown, so the next Open still shows.
    private Task OnNativeCancel() => OnClose.InvokeAsync();

    private void OnNativeClose() => _shown = false;
}
