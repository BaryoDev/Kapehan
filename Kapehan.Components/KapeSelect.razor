@*
  KapeSelect.razor: Kapehan "Select" (Forms).

  GENERATED from kapehan-components.js by scripts/generators/blazor.mjs. Do not edit by
  hand; edit design/Kapehan.dc.html and run `npm run build`. npm test fails if this drifts.

  Styling comes entirely from kapehan.css. Reference it once in the host app:
      <link rel="stylesheet" href="_content/Kapehan.Components/kapehan.css" />

  Props (* = required):
      options*: Array<{ id: string, name: string }>
      modelValue*: string
      label*: string

  Accessibility contract:
      roles: Native select; do not rebuild it unless you need a combobox
      attrs: A label element wrapping or bound by for/id
             aria-invalid on a failed submit
      keys:  Native: arrows open and move, Enter commits, Escape reverts
*@

<label class="kape-select">
    <select @bind="Value">
        @foreach (var b in Options)
        {
            <option value="@b.Id">@b.Name</option>
        }
    </select>
</label>

@code {
    /// <summary>Choices.</summary>
    /// <remarks>Canvas default: <c>[]</c>.</remarks>
    [Parameter] public IReadOnlyList<Branch> Options { get; set; } = [];
    /// <summary>Selected id.</summary>
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
}
