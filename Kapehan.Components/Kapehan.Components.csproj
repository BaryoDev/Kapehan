<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Kapehan.Components: the Razor class library.

    The .razor files, KapeIcon, KapeIcons.g.cs and everything under wwwroot/ are generated
    by scripts/generators/blazor.mjs from the design canvas and committed. `npm test` byte
    compares them, so editing one here is undone by the next `npm run build`. Only this
    file and Models.cs are hand-written.

    Version and package metadata are in ../Directory.Build.props.
  -->

  <PropertyGroup>
    <!--
      Both, always. A multi-target build that quietly stops after the first framework is
      the specific way this goes wrong: net8.0 compiles, net10.0 never does, and the
      package ships with an empty lib/net10.0 that resolves at restore and fails at run.
      The CI job builds each TFM by name for the same reason.
    -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <PackageId>Kapehan.Components</PackageId>
    <RootNamespace>Kapehan.Components</RootNamespace>
    <AssemblyName>Kapehan.Components</AssemblyName>
    <Description>Hand-drawn coffee-shop UI for Blazor: 30 components and 42 icons, styled entirely by CSS variables. No data fetching and no hard-coded colours.</Description>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      1591 is "missing XML comment on a public member". The prop descriptions come from the
      canvas and cover the parameters people actually set; a warning for every generated
      member without one would bury the warnings that matter.
    -->
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!--
      _content/Kapehan.Components/... is what the README tells consumers to link. It is the
      default for this assembly name, but a rename would silently move every consumer's
      stylesheet path, so it is pinned.
    -->
    <StaticWebAssetBasePath>_content/Kapehan.Components</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package readme, which is generated alongside the components. -->
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
