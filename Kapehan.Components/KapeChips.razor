@*
  KapeChips.razor: Kapehan "Chips" (Actions).

  GENERATED from kapehan-components.js by scripts/generators/blazor.mjs. Do not edit by
  hand; edit design/Kapehan.dc.html and run `npm run build`. npm test fails if this drifts.

  Styling comes entirely from kapehan.css. Reference it once in the host app:
      <link rel="stylesheet" href="_content/Kapehan.Components/kapehan.css" />

  Props (* = required):
      options*: string[]
      modelValue*: string
      onChange*: (value: string) => void

  Accessibility contract:
      roles: Each chip is a button; the group needs no role
      attrs: aria-pressed reflects selection on every chip, not just the selected one
      keys:  Tab steps through chips
             Enter or Space presses one
*@

@foreach (var c in Options)
{
    <button class="kape-chip" aria-pressed="@(Value == c)" @onclick="() => Select(c)">@c</button>
}

@code {
    /// <summary>Chip labels.</summary>
    /// <remarks>Canvas default: <c>[]</c>.</remarks>
    [Parameter] public string[] Options { get; set; } = ["All", "Hot", "Iced"];
    /// <summary>Selected label.</summary>
    [Parameter] public string Value { get; set; } = "All";
    /// <summary>Fired with the newly pressed chip.</summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private Task Select(string c) => ValueChanged.InvokeAsync(c);
}
