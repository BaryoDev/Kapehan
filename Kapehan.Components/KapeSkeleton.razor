@*
  KapeSkeleton.razor: Kapehan "Skeleton" (Data).

  GENERATED from kapehan-components.js by scripts/generators/blazor.mjs. Do not edit by
  hand; edit design/Kapehan.dc.html and run `npm run build`. npm test fails if this drifts.

  Styling comes entirely from kapehan.css. Reference it once in the host app:
      <link rel="stylesheet" href="_content/Kapehan.Components/kapehan.css" />

  Props (* = required):
      lines: number
      width: string
      loading*: boolean

  Accessibility contract:
      roles: The loading region needs aria-busy on the container, not on each bar
      attrs: aria-busy="true" while skeletons show
             A visually hidden Loading orders line so the wait is announced once
      keys:  Skeletons are never focusable; keep tab order stable when they swap out
*@

<div aria-busy="@Loading">
    @if (Loading)
    {
        @for (var i = 0; i < Lines; i++)
        {
            <span class="kape-skeleton" style="width:@Width"></span>
        }
    }
    else
    {
        @ChildContent
    }
</div>

@code {
    /// <summary>How many bars to draw.</summary>
    /// <remarks>Canvas default: <c>3</c>.</remarks>
    [Parameter] public int Lines { get; set; } = 3;
    /// <summary>Bar width, per line or shared.</summary>
    /// <remarks>Canvas default: <c>60%</c>.</remarks>
    [Parameter] public string Width { get; set; } = "60%";
    /// <summary>Swap for real content when false.</summary>
    /// <remarks>Canvas default: <c>true</c>.</remarks>
    [Parameter] public bool Loading { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
