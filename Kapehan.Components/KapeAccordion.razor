@*
  KapeAccordion.razor: Kapehan "Accordion" (Data).

  GENERATED from kapehan-components.js by scripts/generators/blazor.mjs. Do not edit by
  hand; edit design/Kapehan.dc.html and run `npm run build`. npm test fails if this drifts.

  Styling comes entirely from kapehan.css. Reference it once in the host app:
      <link rel="stylesheet" href="_content/Kapehan.Components/kapehan.css" />

  Props (* = required):
      items*: Array<{ id: string, q: string, a: string }>
      openFirst: boolean

  Accessibility contract:
      roles: Native details and summary; no ARIA needed
      attrs: Do not add role="button" to summary, the browser already exposes it
             aria-expanded is managed by the open attribute
      keys:  Enter or Space toggles a summary
             Tab moves between summaries
*@

@foreach (var (f, i) in Items.Select((f, i) => (f, i)))
{
    <details class="kape-acc" open="@(OpenFirst && i == 0)">
        <summary>@f.Question</summary>
        <p>@f.Answer</p>
    </details>
}

@code {
    /// <summary>Question and answer pairs.</summary>
    /// <remarks>Canvas default: <c>[]</c>.</remarks>
    [Parameter] public IReadOnlyList<Faq> Items { get; set; } = [];
    /// <summary>Open the first panel on mount.</summary>
    /// <remarks>Canvas default: <c>false</c>.</remarks>
    [Parameter] public bool OpenFirst { get; set; }
}
