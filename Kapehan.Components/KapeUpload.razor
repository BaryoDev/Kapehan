@*
  KapeUpload.razor: Kapehan "File upload" (Forms).

  GENERATED from kapehan-components.js by scripts/generators/blazor.mjs. Do not edit by
  hand; edit design/Kapehan.dc.html and run `npm run build`. npm test fails if this drifts.

  Styling comes entirely from kapehan.css. Reference it once in the host app:
      <link rel="stylesheet" href="_content/Kapehan.Components/kapehan.css" />

  Props (* = required):
      accept: string
      maxSize: number
      files: UploadFile[]
      onFiles*: (files: File[]) => void

  Accessibility contract:
      roles: A label wrapping a real file input; the drop zone is not a button
      attrs: The input stays in the DOM (hidden attribute, not display:none on a wrapper)
             Each in-flight row needs its own progressbar with an aria-label naming the file
      keys:  Tab focuses the input, Enter or Space opens the picker
             Drag and drop is an enhancement, never the only path
*@

<label class="kape-drop">
    <KapeIcon Name="coffee-sack" Size="36" />
    <strong>Drop the menu sheet here</strong>
    <span>CSV or XLSX, up to 10 MB. Or <u>browse</u>.</span>
    <InputFile OnChange="Take" accept="@Accept" hidden multiple />
</label>

@foreach (var f in Files)
{
    <div class="kape-file">
        <span class="kape-file__ext">@f.Ext</span>
        <div class="kape-file__body">
            <span>@f.Name</span>
            <span class="kape-progress" role="progressbar" aria-valuenow="@f.Percent" aria-label="Uploading @f.Name">
                <span style="width:@(f.Percent)%"></span>
            </span>
        </div>
        <button aria-label="Cancel" @onclick="() => OnCancel.InvokeAsync(f)">&times;</button>
    </div>
}

@code {
    /// <summary>Allowed extensions.</summary>
    /// <remarks>Canvas default: <c>.csv,.xlsx</c>.</remarks>
    [Parameter] public string Accept { get; set; } = ".csv,.xlsx";
    /// <summary>Byte ceiling, 10 MB by default.</summary>
    /// <remarks>Canvas default: <c>10485760</c>.</remarks>
    [Parameter] public long MaxSize { get; set; } = 10_485_760;
    /// <summary>Files in flight, each with name, ext and pct.</summary>
    /// <remarks>Canvas default: <c>[]</c>.</remarks>
    [Parameter] public IReadOnlyList<UploadFile> Files { get; set; } = [];
    /// <summary>Fired for both drop and browse.</summary>
    [Parameter] public EventCallback<IReadOnlyList<IBrowserFile>> OnFiles { get; set; }
    [Parameter] public EventCallback<UploadFile> OnCancel { get; set; }

    private Task Take(InputFileChangeEventArgs e) =>
        OnFiles.InvokeAsync(e.GetMultipleFiles().Where(f => f.Size <= MaxSize).ToList());
}
