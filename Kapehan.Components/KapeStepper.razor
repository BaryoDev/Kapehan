@*
  KapeStepper.razor: Kapehan "Stepper" (Forms).

  GENERATED from kapehan-components.js by scripts/generators/blazor.mjs. Do not edit by
  hand; edit design/Kapehan.dc.html and run `npm run build`. npm test fails if this drifts.

  Styling comes entirely from kapehan.css. Reference it once in the host app:
      <link rel="stylesheet" href="_content/Kapehan.Components/kapehan.css" />

  Props (* = required):
      modelValue*: number
      min: number
      max: number
      onChange*: (value: number) => void

  Accessibility contract:
      roles: Two buttons around a native output element
      attrs: aria-label on each button (Fewer, More), never a bare minus sign
             aria-live="polite" on the output so screen readers hear the new count
      keys:  Enter or Space on either button
             Arrow Up and Arrow Down step while the group has focus
*@

<div class="kape-stepper" @onkeydown="OnKey" tabindex="-1">
    <button aria-label="Fewer" disabled="@(Value <= Min)" @onclick="() => Step(-1)">&minus;</button>
    <output aria-live="polite">@Value</output>
    <button aria-label="More" disabled="@(Value >= Max)" @onclick="() => Step(1)">+</button>
</div>

@code {
    /// <summary>Current quantity.</summary>
    /// <remarks>Canvas default: <c>1</c>.</remarks>
    [Parameter] public int Value { get; set; } = 1;
    /// <summary>Fired with the clamped value.</summary>
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    /// <summary>Lower bound.</summary>
    /// <remarks>Canvas default: <c>1</c>.</remarks>
    [Parameter] public int Min { get; set; } = 1;
    /// <summary>Upper bound.</summary>
    /// <remarks>Canvas default: <c>99</c>.</remarks>
    [Parameter] public int Max { get; set; } = 99;

    private Task Step(int n) => ValueChanged.InvokeAsync(Math.Clamp(Value + n, Min, Max));

    private Task OnKey(KeyboardEventArgs e) => e.Key switch
    {
        "ArrowUp" => Step(1),
        "ArrowDown" => Step(-1),
        _ => Task.CompletedTask,
    };
}
