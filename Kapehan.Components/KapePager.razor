@*
  KapePager.razor: Kapehan "Pagination" (Navigation).

  GENERATED from kapehan-components.js by scripts/generators/blazor.mjs. Do not edit by
  hand; edit design/Kapehan.dc.html and run `npm run build`. npm test fails if this drifts.

  Styling comes entirely from kapehan.css. Reference it once in the host app:
      <link rel="stylesheet" href="_content/Kapehan.Components/kapehan.css" />

  Props (* = required):
      page*: number
      pages*: number
      onChange*: (page: number) => void

  Accessibility contract:
      roles: nav with an aria-label such as Menu pages
      attrs: aria-current="page" on the active number
             disabled on the arrows at the ends, not aria-disabled
      keys:  Tab through the numbers
             Enter or Space activates; arrow keys are left to the browser
*@

<nav class="kape-pager" aria-label="Pages">
    <button disabled="@(Page == 1)" aria-label="Previous" @onclick="() => Go(Page - 1)">&lsaquo;</button>
    @for (var p = 1; p <= Pages; p++)
    {
        var n = p;
        <button aria-current="@(n == Page ? "page" : null)" @onclick="() => Go(n)">@n</button>
    }
    <button disabled="@(Page == Pages)" aria-label="Next" @onclick="() => Go(Page + 1)">&rsaquo;</button>
</nav>

@code {
    /// <summary>Current page, 1-based.</summary>
    /// <remarks>Canvas default: <c>1</c>.</remarks>
    [Parameter] public int Page { get; set; } = 1;
    /// <summary>Total pages.</summary>
    /// <remarks>Canvas default: <c>1</c>.</remarks>
    [Parameter] public int Pages { get; set; } = 1;
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    private Task Go(int p) => PageChanged.InvokeAsync(Math.Clamp(p, 1, Pages));
}
