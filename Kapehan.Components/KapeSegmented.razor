@*
  KapeSegmented.razor: Kapehan "Segmented" (Actions).

  GENERATED from kapehan-components.js by scripts/generators/blazor.mjs. Do not edit by
  hand; edit design/Kapehan.dc.html and run `npm run build`. npm test fails if this drifts.

  Styling comes entirely from kapehan.css. Reference it once in the host app:
      <link rel="stylesheet" href="_content/Kapehan.Components/kapehan.css" />

  Props (* = required):
      options*: string[]
      modelValue*: string
      onChange*: (value: string) => void

  Accessibility contract:
      roles: role="group" on the wrapper with an aria-label naming the choice
      attrs: aria-pressed on each segment
      keys:  Tab into the group, Enter or Space to pick
             Arrow keys are not bound; segments are buttons, not a radiogroup
*@

<div class="kape-seg" role="group" aria-label="@Label">
    @foreach (var m in Options)
    {
        <button aria-pressed="@(Value == m)" @onclick="() => ValueChanged.InvokeAsync(m)">@m</button>
    }
</div>

@code {
    /// <summary>Segment labels, two or three.</summary>
    /// <remarks>Canvas default: <c>[]</c>.</remarks>
    [Parameter] public string[] Options { get; set; } = ["Pick up", "Deliver"];
    /// <summary>Selected segment.</summary>
    [Parameter] public string Value { get; set; } = "Pick up";
    /// <summary>Fired with the picked segment.</summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Fulfilment";
}
