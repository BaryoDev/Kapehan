@*
  KapeInput.razor: Kapehan "Input" (Forms).

  GENERATED from kapehan-components.js by scripts/generators/blazor.mjs. Do not edit by
  hand; edit design/Kapehan.dc.html and run `npm run build`. npm test fails if this drifts.

  Styling comes entirely from kapehan.css. Reference it once in the host app:
      <link rel="stylesheet" href="_content/Kapehan.Components/kapehan.css" />

  Props (* = required):
      modelValue*: string
      placeholder: string
      icon: string | null
      type: string

  Accessibility contract:
      roles: Wrapping label makes the icon and field one hit target
      attrs: A visible label or aria-label is required
             aria-describedby for hint or error text
      keys:  Tab focuses the field; the wrapper takes the focus ring via :focus-within
*@

<label class="kape-input">
    @if (Icon is not null)
    {
        <KapeIcon Name="@Icon" Size="18" />
    }
    <input type="@Type" placeholder="@Placeholder" @bind="Value" @bind:event="oninput" />
</label>

@code {
    /// <summary>Field value.</summary>
    /// <remarks>Canvas default: <c>""</c>.</remarks>
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    /// <summary>Empty-state hint.</summary>
    /// <remarks>Canvas default: <c>Search the menu</c>.</remarks>
    [Parameter] public string Placeholder { get; set; } = "Search the menu";
    /// <summary>Leading Kapehan icon.</summary>
    /// <remarks>Canvas default: <c>grinder</c>.</remarks>
    [Parameter] public string? Icon { get; set; } = "grinder";
    /// <summary>Native input type.</summary>
    /// <remarks>Canvas default: <c>search</c>.</remarks>
    [Parameter] public string Type { get; set; } = "search";
}
